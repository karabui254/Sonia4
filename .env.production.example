NODE_ENV=production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require
FARM_TIMEZONE=Africa/Nairobi
# Let Render provide PORT. Both farm records and sessions use PostgreSQL.
# ADMIN_PASSWORD is needed only to bootstrap a brand-new empty database.
# Existing accounts retain their stored password hashes.

{
  "name": "sonia-4-farm-sqlite",
  "version": "4.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "db:migrate": "node database/migrate.js",
    "test:access-control": "node --test --test-concurrency=1 scripts/workflow.test.js",
    "test:audit-void": "node --test --test-concurrency=1 scripts/workflow.test.js",
    "test:master-data": "node --test --test-concurrency=1 scripts/workflow.test.js",
    "test": "node --test --test-concurrency=1 scripts/workflow.test.js scripts/mvp.test.js scripts/postgres.test.js scripts/import-production.test.js scripts/analytics.test.js",
    "check": "node scripts/check.js",
    "backup": "node scripts/backup.js",
    "db:restore": "node scripts/restore.js",
    "build:production": "node scripts/build-production.js",
    "test:postgres": "node --test scripts/postgres.test.js",
    "backup:postgres": "node scripts/postgres-snapshot.js export",
    "restore:postgres": "node scripts/postgres-snapshot.js restore-empty"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "otplib": "^13.3.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4"
  },
  "main": "backend/server.js",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
